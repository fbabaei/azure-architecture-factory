{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azure-architecture-factory/contracts/v1/design-contract.schema.json",
  "title": "AAF Design Contract",
  "description": "Conceptual / logical architecture produced by the Design layer. Consumed by the Architecture layer (implementation). Includes high-level components and Azure service mapping at the C1/C2 level — but NOT production-grade Bicep/Terraform, ADRs, or deployment guidance.",
  "type": "object",
  "required": [
    "contract_version",
    "project_slug",
    "intake_ref",
    "logical_architecture",
    "high_level_components",
    "data_flow",
    "design_rationale",
    "diagram_artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": { "type": "string", "const": "1.0.0" },
    "project_slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "intake_ref": {
      "type": "object",
      "required": ["contract_version", "checksum"],
      "properties": {
        "contract_version": { "type": "string" },
        "checksum": { "type": "string", "description": "SHA-256 of the intake contract that produced this design." }
      }
    },
    "logical_architecture": {
      "type": "object",
      "required": ["pattern", "summary"],
      "properties": {
        "pattern": {
          "type": "string",
          "enum": [
            "microservices",
            "event-driven",
            "n-tier",
            "serverless",
            "data-pipeline",
            "agentic",
            "hub-spoke",
            "monolith",
            "hybrid"
          ]
        },
        "summary": { "type": "string", "minLength": 30 }
      }
    },
    "high_level_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibility", "azure_service_candidates"],
        "properties": {
          "id": { "type": "string", "pattern": "^C-[0-9]{2,}$" },
          "name": { "type": "string" },
          "responsibility": { "type": "string" },
          "azure_service_candidates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "Candidate Azure services (e.g., 'Container Apps', 'Cosmos DB'). Final selection happens in Architecture layer."
          },
          "implements_requirements": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-(F|NF)-[0-9]{3,}$" }
          },
          "trust_boundary": {
            "type": "string",
            "enum": ["public", "internal", "data", "identity", "management"]
          }
        }
      }
    },
    "data_flow": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["from", "to", "protocol"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "protocol": { "type": "string", "enum": ["https", "grpc", "amqp", "mqtt", "sql", "event-grid", "service-bus", "event-hubs", "internal"] },
          "data_classification": { "type": "string", "enum": ["public", "internal", "confidential", "restricted", "pii", "phi"] },
          "auth": { "type": "string", "enum": ["managed-identity", "oauth2", "api-key", "mtls", "none"] }
        }
      }
    },
    "design_rationale": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["decision", "alternatives_considered", "reasoning"],
        "properties": {
          "decision": { "type": "string" },
          "alternatives_considered": { "type": "array", "items": { "type": "string" } },
          "reasoning": { "type": "string" },
          "links_to": {
            "type": "array",
            "items": { "type": "string", "pattern": "^REQ-(F|NF)-[0-9]{3,}$" }
          }
        }
      }
    },
    "diagram_artifacts": {
      "type": "object",
      "required": ["drawio_path", "notes_path"],
      "properties": {
        "drawio_path": { "type": "string" },
        "notes_path": { "type": "string" },
        "diagram_source": { "type": "string", "enum": ["mcp-generated", "imported"] }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question"],
        "properties": {
          "question": { "type": "string" },
          "blocks_phase": { "type": "string", "enum": ["2", "2.6", "2.8", "3", "5"] }
        }
      }
    }
  }
}
