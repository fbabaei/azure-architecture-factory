{
  "apiVersion": "aaf.applicationzone/v1",
  "kind": "AppPack",
  "metadata": {
    "packId": "mailer-automation",
    "displayName": "Mailer Automation",
    "version": "0.1.0",
    "owner": "ai-apps-service-core",
    "supportTier": "candidate",
    "status": "candidate"
  },
  "compatibility": {
    "minimumAAFVersion": "0.9.0",
    "supportedRegions": [
      "eastus",
      "westeurope",
      "westus3"
    ],
    "requiredServices": [
      "azure-ai-foundry",
      "azure-openai",
      "azure-content-understanding",
      "azure-ai-search",
      "blob-storage",
      "application-insights"
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "environmentName",
        "type": "string"
      },
      {
        "name": "region",
        "type": "enum",
        "allowedValues": [
          "eastus",
          "westeurope",
          "westus3"
        ]
      },
      {
        "name": "facilityProfile",
        "type": "string"
      }
    ],
    "optional": [
      {
        "name": "enableHumanReview",
        "type": "boolean"
      },
      {
        "name": "retentionDays",
        "type": "integer"
      }
    ]
  },
  "deployment": {
    "runtimeProfiles": [
      "dev",
      "test",
      "prod"
    ],
    "defaultProfile": "dev"
  },
  "security": {
    "managedIdentityRequired": true,
    "keyVaultRequired": true,
    "requiredPolicies": [
      "rbac-least-privilege",
      "diagnostic-logs-enabled",
      "human-in-the-loop-for-mail-decisions",
      "audit-trail-required"
    ]
  },
  "operations": {
    "healthChecks": [
      "/api/health",
      "/docs"
    ],
    "sloTargets": {
      "availability": "99.5%",
      "p95LatencyMs": 4000
    }
  },
  "lifecycle": {
    "upgradeStrategy": "precheck-then-roll",
    "rollbackSupported": true
  },
  "packaging": {
    "executionModel": "independent",
    "sourceProjectSlug": "mailer-automation",
    "sourceProjectPath": "C:\\dev\\workspace\\Mailer-Automation",
    "exportIncludes": [
      "README.md",
      "api",
      "content-analysis-agent",
      "digitization-agent",
      "frontend-angular",
      "mailer-webhook-api",
      "Infra",
      "Docker",
      "documents",
      "quickstart",
      "Scaling",
      "Utilities"
    ]
  },
  "verification": {
    "smokeTests": [
      "MailerAutomation"
    ],
    "evaluationPlan": "evals/starter-eval-plan.json"
  }
}
