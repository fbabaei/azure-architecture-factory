# Casewright configuration template.
#
# Every value below is optional at import time — the app loads with safe defaults and only
# needs Azure connectivity at call time. Copy to `.env` and fill in for local runs, or inject
# these as container-app / function-app settings in deployment. Managed identity
# (DefaultAzureCredential) is used for every Azure hop, so these are endpoints/ids, not keys.

# --- Azure AI Search ---
SEARCHSERVICE_ENDPOINT=https://<search>.search.windows.net
SEARCH_INDEX_NAME=casewright-index
SEARCH_SEMANTIC_CONFIGURATION=casewright-semantic
SEARCH_MIN_RERANKER_SCORE=2.0
SEARCH_TOP_K=8
INGESTION_CHUNK_SIZE=3000
INGESTION_CHUNK_OVERLAP=500

# --- Foundry IQ knowledge base (agentic retrieval; preview REST) ---
# Provisioned by `python scripts/deploy_agent.py deploy`. Defaults match the manifest, so a
# minimal setup only needs SEARCHSERVICE_ENDPOINT + the OpenAI + Foundry values below.
SEARCH_KB_API_VERSION=2025-11-01-preview
SEARCH_KB_NAME=casewright-kb
SEARCH_KB_KS_NAME=casewright-ks
# SEARCH_KB_DESCRIPTION=
# SEARCH_KB_RETRIEVAL_INSTRUCTIONS=
# AOAI endpoint/deployment for the KB fall back to AZURE_OPENAI_ENDPOINT / chat deployment.
# SEARCH_KB_AOAI_ENDPOINT=
# SEARCH_KB_AOAI_DEPLOYMENT_NAME=
SEARCH_KB_OUTPUT_MODALITY=extractiveData
SEARCH_KB_RETRIEVAL_REASONING_EFFORT=medium
SEARCH_KB_DEFAULT_RERANKER_THRESHOLD=2.0
SEARCH_KB_MAX_OUTPUT_SIZE=5000
SEARCH_KB_ATTEMPT_FAST_PATH=true
# Source index/fields fall back to SEARCH_INDEX_NAME / SEARCH_SEMANTIC_CONFIGURATION.
# SEARCH_KB_KS_INDEX_NAME=
# SEARCH_KB_KS_DESCRIPTION=
# SEARCH_KB_KS_SOURCE_DATA_FIELDS=["content","title"]
# SEARCH_KB_KS_SEARCH_FIELDS=["content"]
# SEARCH_KB_KS_SEMANTIC_CONFIGURATION_NAME=
# RemoteTool project connection that binds the agent's MCP tool to the KB endpoint.
FOUNDRY_KB_CONNECTION_NAME=casewright-kb-mcp

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<aoai>.openai.azure.com
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# --- Storage (ingestion landing + knowledge store) ---
BLOBSTORAGE_ACCOUNT_URL=https://<storage>.blob.core.windows.net
INGESTION_CONTAINER=ingestion
KNOWLEDGE_STORE_CONTAINER=knowledge-store

# --- Cosmos DB ---
COSMOS_ENDPOINT=https://<cosmos>.documents.azure.com:443/
COSMOS_DATABASE=casewright
COSMOS_HISTORY_CONTAINER=chat-history
COSMOS_SYNC_STATE_CONTAINER=sync-state

# --- Service Bus ---
SERVICEBUS_FULLY_QUALIFIED_NAMESPACE=<namespace>.servicebus.windows.net
SERVICEBUS_QUEUE_NAME=sharepoint-sync

# --- Microsoft Graph (SharePoint) ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# --- Azure AI Foundry (hosted agent; enables Foundry IQ retrieval at runtime) ---
# FOUNDRY_AGENT_ID is printed by `scripts/deploy_agent.py deploy`. With both set, the agent
# retrieves through the KB MCP tool; otherwise the service falls back to the in-process query.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_ID=

# --- Knowledge-base provisioning (used by scripts/deploy_agent.py, not the runtime app) ---
# The project resource id is derived from FOUNDRY_PROJECT_ENDPOINT + the two values below,
# or pass --project-resource-id explicitly to the deploy script.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# --- Scheduler ---
SHAREPOINT_SYNC_SCHEDULE=0 0 */6 * * *
SYNC_DEFAULT_TENANT_ID=
