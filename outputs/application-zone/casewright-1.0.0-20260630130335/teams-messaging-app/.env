PORT=3978

# --- Foundry agent (real values from azd env casewright-dev) ----------------
AGENT_NAME=case-knowledge-agent
PROJECT_ENDPOINT=https://casewright-foundry-wrlidt67.services.ai.azure.com/api/projects/casewright-proj

# Keyword that triggers the SharePoint broadcast workflow.
BROADCAST_COMMAND=broadcast

# --- Identity ---------------------------------------------------------------
# SKIP_AUTH=true keeps local Agents Playground / tests working without bot creds.
SKIP_AUTH=true

# Real tenant / subscription (az account show).
TENANT_ID=f5d3b574-19e1-4815-a4a7-468c285b8769
AZURE_TENANT_ID=f5d3b574-19e1-4815-a4a7-468c285b8769
AZURE_SUBSCRIPTION_ID=729fcdbd-c547-48df-a749-dbee6cdb50b0

# NOTE: No service-principal secret exists in the repo. AZURE_CLIENT_ID /
# AZURE_CLIENT_SECRET are intentionally omitted so the SharePoint test's
# DefaultAzureCredential falls through to your az CLI login (delegated Graph).
# If you create an app registration with admin-consented Sites.Read.All /
# Group.Read.All / User.Read.All, add all three below to force EnvironmentCredential:
# AZURE_CLIENT_ID=<app id>
# AZURE_CLIENT_SECRET=<secret>

# --- Cosmos DB conversation-reference store (optional; not used by the
#     SharePoint fetch test). Uses AAD when COSMOS_KEY is omitted. -----------
COSMOS_ENDPOINT=https://casewright-cosmos-wrlidt67.documents.azure.com:443/
COSMOS_DATABASE=casewright
COSMOS_CONTAINER=conversation_references
