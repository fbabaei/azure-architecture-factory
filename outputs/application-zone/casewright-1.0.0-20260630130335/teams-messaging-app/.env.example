PORT=3978
AGENT_NAME=<Agent Name>
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>

# Keyword (case-insensitive) that triggers the SharePoint site broadcast
# workflow instead of a normal agent chat turn.
BROADCAST_COMMAND=broadcast

# --- Bot identity (Phase 4) -------------------------------------------------
# Leave SKIP_AUTH=true for local Agents Playground testing. In deployed
# environments set SKIP_AUTH=false so incoming Bot Service requests are
# validated; then CLIENT_ID, CLIENT_SECRET, and TENANT_ID are all required.
SKIP_AUTH=true
CLIENT_ID=<bot app id>
CLIENT_SECRET=<bot client secret>
TENANT_ID=<tenant id>

# --- Cosmos DB conversation-reference store (Phase 5) -----------------------
# When ENDPOINT, DATABASE, and CONTAINER are all set, proactive conversation
# references are persisted to Cosmos (container partition key: /userKey).
# Otherwise an in-memory (non-durable) store is used. Omit COSMOS_KEY to use
# AAD (DefaultAzureCredential) instead of a key.
COSMOS_ENDPOINT=https://<your-account>.documents.azure.com:443/
COSMOS_DATABASE=<database name>
COSMOS_CONTAINER=conversation_references
# COSMOS_KEY=<account key>