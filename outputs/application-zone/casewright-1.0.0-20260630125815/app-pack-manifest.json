{
  "apiVersion": "aaf.applicationzone/v1",
  "kind": "AppPack",
  "metadata": {
    "packId": "casewright",
    "displayName": "CaseWright",
    "version": "1.0.0",
    "owner": "aaf-core",
    "supportTier": "standard",
    "status": "preview"
  },
  "compatibility": {
    "minimumAAFVersion": "0.9.0",
    "supportedRegions": [
      "eastus",
      "westeurope",
      "westus3"
    ],
    "requiredServices": [
      "azure-openai",
      "azure-ai-search",
      "key-vault",
      "application-insights"
    ]
  },
  "inputs": {
    "required": [
      {
        "name": "environmentName",
        "type": "string"
      },
      {
        "name": "region",
        "type": "enum",
        "allowedValues": [
          "eastus",
          "westeurope",
          "westus3"
        ]
      },
      {
        "name": "identityMode",
        "type": "enum",
        "allowedValues": [
          "system-assigned",
          "user-assigned"
        ]
      },
      {
        "name": "documentSource",
        "type": "object",
        "requiredFields": [
          "type",
          "resourceId"
        ]
      },
      {
        "name": "modelProfile",
        "type": "enum",
        "allowedValues": [
          "balanced",
          "quality",
          "cost"
        ]
      }
    ],
    "optional": [
      {
        "name": "channelMode",
        "type": "enum",
        "allowedValues": [
          "web",
          "teams"
        ]
      },
      {
        "name": "retentionDays",
        "type": "integer"
      },
      {
        "name": "strictCitationMode",
        "type": "boolean"
      }
    ]
  },
  "deployment": {
    "runtimeProfiles": [
      "dev",
      "test",
      "prod"
    ],
    "defaultProfile": "dev"
  },
  "security": {
    "managedIdentityRequired": true,
    "keyVaultRequired": true,
    "requiredPolicies": [
      "rbac-least-privilege",
      "diagnostic-logs-enabled"
    ]
  },
  "operations": {
    "healthChecks": [
      "/health",
      "/health/ready"
    ],
    "sloTargets": {
      "availability": "99.9%",
      "p95LatencyMs": 2000
    }
  },
  "lifecycle": {
    "upgradeStrategy": "precheck-then-roll",
    "rollbackSupported": true
  },
  "packaging": {
    "executionModel": "independent",
    "sourceProjectSlug": "casewright",
    "exportIncludes": [
      "README.md",
      "DEPLOY.md",
      "pyproject.toml",
      "azure.yaml",
      ".env.example",
      "src",
      "infra",
      "docs",
      "scripts",
      "tests",
      "diagrams",
      "frontend",
      "teams-messaging-app"
    ]
  }
}