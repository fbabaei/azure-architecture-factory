                <mxCell id="principles-header" value="KEY ARCHITECTURE PRINCIPLES" style="text;fontSize=11;fontStyle=bold;align=left;" parent="1" vertex="1">
                    <mxGeometry x="50" y="820" width="1000" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="principles" value="• Medallion Pattern: Raw (Bronze) → Cleaned (Silver) → Analytics-Ready (Gold)&#xa;• Workspace Separation: Independent workspaces for each layer enable isolation and governance&#xa;• Python ETL: Flexible transformations using Python notebooks across all layers&#xa;• Data Lineage: Purview tracks data origin, transformations, and dependencies&#xa;• Mirrored Data: Snowflake data synchronized to Fabric for unified analytics&#xa;• Semantic Model: Gold layer semantic models enable Power BI for self-service analytics&#xa;• Zero Trust Security: RBAC + DLP + Defender for Cloud enforce security at all levels&#xa;• Real-time Monitoring: Fabric monitoring + Azure Monitor provide comprehensive observability" style="text;fontSize=9;align=left;verticalAlign=top;" parent="1" vertex="1">
                    <mxGeometry x="50" y="845" width="1000" height="130" as="geometry"/>
                </mxCell>
