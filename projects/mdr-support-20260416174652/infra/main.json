        "[resourceId('Microsoft.CognitiveServices/accounts', format('{0}-openai', variables('baseName')))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-06-01-preview",
      "name": "[format('{0}/{1}', format('{0}-openai', variables('baseName')), parameters('openAiEmbeddingsDeployment'))]",
      "sku": {
        "name": "Standard",
        "capacity": 20
