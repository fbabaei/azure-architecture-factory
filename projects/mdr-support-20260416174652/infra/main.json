      "kind": "FormRecognizer",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true,
        "customSubDomainName": "[format('{0}-docintel', variables('baseName'))]"
      }
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-cae', variables('baseName'))]",
