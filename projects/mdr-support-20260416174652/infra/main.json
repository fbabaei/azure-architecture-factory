        "disableLocalAuth": true,
        "customSubDomainName": "[format('{0}-openai', variables('baseName'))]"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-06-01-preview",
      "name": "[format('{0}/{1}', format('{0}-openai', variables('baseName')), parameters('openAiChatDeployment'))]",
      "sku": {
        "name": "Standard",
        "capacity": 20
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('openAiChatModel')]",
