      "apiVersion": "2024-03-01",
      "name": "[format('{0}-api', variables('baseName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', variables('baseName'))))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-cae', variables('baseName')))]",
        "configuration": {
          "ingress": {
            "external": true,
            "targetPort": 8000,
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": "[if(parameters('provisionAcr'), createArray(createObject('server', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer, 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', variables('baseName'))))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "mdr-agent",
              "image": "[if(not(empty(parameters('containerImage'))), parameters('containerImage'), if(parameters('provisionAcr'), format('{0}/mdr-agent:latest', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-11-01-preview').loginServer), 'mcr.microsoft.com/azuredocs/containerapps-helloworld:latest'))]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1.0Gi"
              },
              "env": [
                {
                  "name": "AZURE_OPENAI_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('{0}-openai', variables('baseName'))), '2024-06-01-preview').endpoint]"
                },
                {
                  "name": "AZURE_OPENAI_DEPLOYMENT",
                  "value": "[parameters('openAiChatDeployment')]"
                },
                {
                  "name": "AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT",
                  "value": "[parameters('openAiEmbeddingsDeployment')]"
                },
                {
                  "name": "AZURE_DOC_INTEL_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', format('{0}-docintel', variables('baseName'))), '2024-06-01-preview').endpoint]"
                },
                {
                  "name": "AZURE_BLOB_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
                },
                {
                  "name": "AZURE_BLOB_CONTAINER",
                  "value": "mdr-documents"
                },
                {
                  "name": "AZURE_COSMOS_ENDPOINT",
                  "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos', variables('baseName'))), '2024-05-15').documentEndpoint]"
                },
                {
                  "name": "AZURE_COSMOS_DATABASE",
                  "value": "mdr"
                },
                {
                  "name": "AZURE_COSMOS_ARRANGEMENTS_CONTAINER",
                  "value": "arrangements"
                },
                {
                  "name": "AZURE_COSMOS_SESSIONS_CONTAINER",
                  "value": "sessions"
                },
                {
                  "name": "AZURE_COSMOS_CASE_DRAFTS_CONTAINER",
                  "value": "case-drafts"
                },
                {
                  "name": "AZURE_COSMOS_AUDIT_CONTAINER",
                  "value": "audit-log"
                },
                {
                  "name": "AZURE_AI_SEARCH_ENDPOINT",
                  "value": "[format('https://{0}.search.windows.net', format('{0}-aisearch', variables('baseName')))]"
                },
                {
                  "name": "AZURE_AI_SEARCH_INDEX_NAME",
                  "value": "compliance-knowledge-base"
                },
                {
                  "name": "AZURE_AI_SEARCH_VECTOR_FIELD",
                  "value": "contentVector"
                },
                {
                  "name": "AZURE_AI_SEARCH_SEMANTIC_CONFIGURATION",
                  "value": "default"
                },
                {
                  "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                  "value": "[if(parameters('enableObservability'), reference(resourceId('Microsoft.Insights/components', format('{0}-appi', variables('baseName'))), '2020-02-02').ConnectionString, '')]"
                },
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', variables('baseName'))), '2023-01-31').clientId]"
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": 1,
            "maxReplicas": 3
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.Search/searchServices', format('{0}-aisearch', variables('baseName')))]",
        "[resourceId('Microsoft.Insights/components', format('{0}-appi', variables('baseName')))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers', format('{0}-cosmos', variables('baseName')), 'mdr', 'arrangements')]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers', format('{0}-cosmos', variables('baseName')), 'mdr', 'audit-log')]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers', format('{0}-cosmos', variables('baseName')), 'mdr', 'case-drafts')]",
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-cae', variables('baseName')))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', format('{0}-cosmos', variables('baseName')))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases', format('{0}-cosmos', variables('baseName')), 'mdr')]",
        "[resourceId('Microsoft.CognitiveServices/accounts', format('{0}-docintel', variables('baseName')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/blobServices/containers', variables('storageName'), 'default', 'mdr-documents')]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-mi', variables('baseName')))]",
        "[resourceId('Microsoft.CognitiveServices/accounts', format('{0}-openai', variables('baseName')))]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts/sqlDatabases/containers', format('{0}-cosmos', variables('baseName')), 'mdr', 'sessions')]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "type": "Microsoft.ApiManagement/service",
      "apiVersion": "2023-05-01-preview",
      "name": "[format('{0}-apim', variables('baseName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Developer",
        "capacity": 1
      },
      "properties": {
        "publisherName": "EY Tax MDR",
        "publisherEmail": "[if(empty(parameters('operationsEmail')), 'opsteam@example.com', parameters('operationsEmail'))]"
      },
      "identity": {
        "type": "SystemAssigned"
      }
    },
    {
