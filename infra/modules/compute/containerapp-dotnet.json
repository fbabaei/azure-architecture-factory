{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.42.1.51946",
      "templateHash": "16625503282054505378"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "containerAppName": {
      "type": "string"
    },
    "containerEnvId": {
      "type": "string"
    },
    "containerImageUri": {
      "type": "string"
    },
    "managedIdentityId": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "containerPort": {
      "type": "int",
      "defaultValue": 8080,
      "metadata": {
        "description": "Container port. Default 8080 aligns with the lang-dotnet Dockerfile template."
      }
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": {
        "description": "CPU cores allocated to the container"
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "1Gi",
      "metadata": {
        "description": "Memory allocated to the container"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum replica count"
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 5,
      "metadata": {
        "description": "Maximum replica count"
      }
    },
    "envVars": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Additional environment variables as name/value pairs. ASPNETCORE_* defaults are added automatically."
      }
    },
    "secrets": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Secret references as name/value pairs"
      }
    },
    "registries": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Container registry configuration entries"
      }
    },
    "externalIngress": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether ingress is external (internet-facing)"
      }
    },
    "appInsightsConnectionString": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Application Insights connection string. If provided, wired into APPLICATIONINSIGHTS_CONNECTION_STRING."
      }
    },
    "aspNetCoreEnvironment": {
      "type": "string",
      "defaultValue": "[if(equals(parameters('environment'), 'dev'), 'Development', 'Production')]",
      "metadata": {
        "description": "ASP.NET Core environment name. Production for non-dev, Development otherwise."
      }
    }
  },
  "variables": {
    "dotnetEnvVars": "[concat(createArray(createObject('name', 'ASPNETCORE_URLS', 'value', format('http://+:{0}', parameters('containerPort'))), createObject('name', 'ASPNETCORE_ENVIRONMENT', 'value', parameters('aspNetCoreEnvironment')), createObject('name', 'DOTNET_RUNNING_IN_CONTAINER', 'value', 'true'), createObject('name', 'DOTNET_SYSTEM_GLOBALIZATION_INVARIANT', 'value', 'false')), if(empty(parameters('appInsightsConnectionString')), createArray(), createArray(createObject('name', 'APPLICATIONINSIGHTS_CONNECTION_STRING', 'value', parameters('appInsightsConnectionString')))), parameters('envVars'))]"
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-02-preview",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityId'))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('containerEnvId')]",
        "configuration": {
          "activeRevisionsMode": "single",
          "registries": "[parameters('registries')]",
          "secrets": "[parameters('secrets')]",
          "ingress": {
            "external": "[parameters('externalIngress')]",
            "targetPort": "[parameters('containerPort')]",
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          }
        },
        "template": {
          "containers": [
            {
              "name": "[parameters('containerAppName')]",
              "image": "[parameters('containerImageUri')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": "[variables('dotnetEnvVars')]",
              "probes": [
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('containerPort')]",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 10,
                  "periodSeconds": 30,
                  "failureThreshold": 3
                },
                {
                  "type": "Readiness",
                  "httpGet": {
                    "path": "/health/ready",
                    "port": "[parameters('containerPort')]",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 15,
                  "failureThreshold": 3
                },
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": "[parameters('containerPort')]",
                    "scheme": "HTTP"
                  },
                  "initialDelaySeconds": 5,
                  "periodSeconds": 5,
                  "failureThreshold": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-scale",
                "http": {
                  "metadata": {
                    "concurrentRequests": "50"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "containerAppId": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
    },
    "containerAppName": {
      "type": "string",
      "value": "[parameters('containerAppName')]"
    },
    "containerAppFqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-02-preview').configuration.ingress.fqdn]"
    }
  }
}