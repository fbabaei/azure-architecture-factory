{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.41.2.15936",
      "templateHash": "700509071645715612"
    }
  },
  "parameters": {
    "location": {
      "type": "string"
    },
    "containerAppName": {
      "type": "string"
    },
    "containerEnvId": {
      "type": "string"
    },
    "containerImageUri": {
      "type": "string"
    },
    "containerPort": {
      "type": "int"
    },
    "managedIdentityId": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "defaultValue": {}
    },
    "cpu": {
      "type": "string",
      "defaultValue": "0.5",
      "metadata": {
        "description": "CPU cores allocated to the container"
      }
    },
    "memory": {
      "type": "string",
      "defaultValue": "1Gi",
      "metadata": {
        "description": "Memory allocated to the container"
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum replica count"
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "metadata": {
        "description": "Maximum replica count"
      }
    },
    "envVars": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Environment variables as name/value pairs"
      }
    },
    "secrets": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Secret references as name/value pairs"
      }
    },
    "externalIngress": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether ingress is external (internet-facing)"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2023-05-02-preview",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', parameters('managedIdentityId'))]": {}
        }
      },
      "properties": {
        "managedEnvironmentId": "[parameters('containerEnvId')]",
        "configuration": {
          "activeRevisionsMode": "single",
          "ingress": {
            "external": "[parameters('externalIngress')]",
            "targetPort": "[parameters('containerPort')]",
            "transport": "auto",
            "allowInsecure": false,
            "traffic": [
              {
                "latestRevision": true,
                "weight": 100
              }
            ]
          },
          "secrets": "[parameters('secrets')]"
        },
        "template": {
          "containers": [
            {
              "image": "[parameters('containerImageUri')]",
              "name": "[parameters('containerAppName')]",
              "resources": {
                "cpu": "[json(parameters('cpu'))]",
                "memory": "[parameters('memory')]"
              },
              "env": "[parameters('envVars')]"
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]",
            "rules": [
              {
                "name": "http-requests",
                "http": {
                  "metadata": {
                    "concurrentRequests": "10"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "outputs": {
    "fqdn": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-02-preview').configuration.ingress.fqdn]"
    },
    "url": {
      "type": "string",
      "value": "[format('https://{0}', reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2023-05-02-preview').configuration.ingress.fqdn)]"
    },
    "id": {
      "type": "string",
      "value": "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
    }
  }
}